{
  "manifestVersion": 2,
  "id": "release-status",
  "name": "PRs, Actions and Releases Status",
  "version": "0.1.0",
  "description": "GitHub Actions and release status for the project of the focused workspace, any of its branches and any repository you add. Re-runs failed runs and asks an agent to take over.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "releases",
        "title": "PRs, Actions and Releases",
        "icon": "rocket",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "workspace:read" },
    { "kind": "notifications:show" },
    { "kind": "agent:read" },
    { "kind": "terminal:send" }
  ]
}
